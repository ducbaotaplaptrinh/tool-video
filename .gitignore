# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs & caches
dist/
build/
.cache/
.remotion/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# SQLite & local databases
*.db
*.db-journal
*.sqlite
